# Copy this file to .env and fill in the values.

# Public hostname of your Plex server. It needs a DNS A/AAAA record
# pointing to this machine, and ports 80 and 443 open.
DOMAIN=plex.example.com

# Email used for the Let's Encrypt account.
ACME_EMAIL=you@example.com

# Claim token from https://plex.tv/claim. It expires after 4 minutes and is
# only needed on the first start, to link the server to your Plex account.
PLEX_CLAIM=claim-xxxxxxxxxxxxxxxxxxxx

# Name of the server shown in the Plex apps.
PLEX_SERVER_NAME=plex

# Numeric user and group that own the Plex files. Get yours with `id -u` and `id -g`.
PUID=1000
PGID=1000

TZ=Europe/Paris

# Folder holding your media. It is mounted at /data inside the container.
MEDIA_PATH=./data

# Uncomment to test against the Let's Encrypt staging server (no rate limits,
# untrusted certificates). Delete letsencrypt/acme.json when switching back.
# ACME_CA_SERVER=https://acme-staging-v02.api.letsencrypt.org/directory
